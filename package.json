{
  "name": "skillswap-root",
  "version": "1.0.0",
  "private": true,
  "description": "SkillSwap — Micro-Mentorship & Skill Exchange Hub",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "seed": "npm run seed --workspace=server",
    "demo:reset": "npm run seed --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "node scripts/start-prod.mjs",
    "demo:prod": "node scripts/demo-prod.mjs",
    "test:db": "node server/tests/db-sanity.js",
    "test:bookings": "node server/tests/bookings.test.js",
    "test:sockets": "node server/tests/sockets.test.js",
    "test:profile": "node server/tests/profile.test.js",
    "test:room": "node server/tests/room.test.js",
    "test:ledger": "node server/tests/ledger.test.js",
    "test:slice7": "node server/tests/slice7.test.js",
    "test:integrity": "node server/tests/integrity.test.js",
    "test:prod": "node server/tests/prod.test.js",
    "test:demo": "node server/tests/demo.test.js",
    "test:match": "node server/tests/match.test.js",
    "test:failsafe": "node server/tests/failsafe.js",
    "smoke": "node scripts/smoke.mjs",
    "test:all": "npm run test:db && npm run test:bookings && npm run test:sockets && npm run test:profile && npm run test:room && npm run test:ledger && npm run test:slice7 && npm run test:integrity && npm run test:prod && npm run test:demo && npm run test:match"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.21.5"
  }
}
