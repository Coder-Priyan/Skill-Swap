{
  "name": "skillswap-root",
  "version": "1.0.0",
  "private": true,
  "description": "SkillSwap — Micro-Mentorship & Skill Exchange Hub",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "seed": "npm run seed --workspace=server",
    "test:db": "node server/tests/db-sanity.js",
    "test:bookings": "node server/tests/bookings.test.js",
    "test:sockets": "node server/tests/sockets.test.js",
    "test:profile": "node server/tests/profile.test.js",
    "test:room": "node server/tests/room.test.js",
    "test:all": "npm run test:db && npm run test:bookings && npm run test:sockets && npm run test:profile && npm run test:room",
    "test:ledger": "node -e \"console.log('added in slice 6')\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@esbuild/win32-x64": "0.21.5"
  }
}
