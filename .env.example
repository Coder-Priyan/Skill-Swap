PORT=4000
CLIENT_PORT=5173
DB_PATH=./data/skillswap.db
NODE_ENV=development

# WebRTC Audio-Only Calling Configuration (Voice in the room)
RTC_ENABLED=true
RTC_SIGNAL_MAX_BYTES=16384
RTC_RATE_LIMIT=60
RTC_STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN Server Configuration (all 3 required if TURN is used; never hardcode credentials)
# RTC_TURN_URL=turn:turn.example.com:3478
# RTC_TURN_USERNAME=myuser
# RTC_TURN_CREDENTIAL=mypassword

